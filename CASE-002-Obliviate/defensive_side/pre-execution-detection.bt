#!/usr/bin/env bpftrace

#include <linux/fs.h>
#include <linux/kernel_read_file.h>

BEGIN {
    printf("Detecting the Kernel module before fully loading ...\n");
}

//If you load the kernel module via the finit_module syscall, this will trigger.
fentry:vmlinux:security_kernel_read_file{
    $file = (struct file *)args->file;
    $read_file_id = args->id;

    // This id is kernel dependent, so check READING_MODULE number before this check
    if ($read_file_id == 2){
        // extract details
        $file_name = str($file->f_path.dentry->d_name.name);
        $parent_dir = str($file->f_path.dentry->d_parent->d_name.name);

        printf("\nTry to load kernel module via finit_module syscall! \n");
        printf("PID: %d, Comm: %s \n", pid, comm);
        printf("filename: %s \n", $file_name);
        printf("Parent dir: %s \n", $parent_dir);
        printf("\n");
    }
}

//If you load the kernel module via the init_module syscall, this will trigger.
fentry:vmlinux:security_kernel_load_data{
    $read_file_id = args->id;

    if($read_file_id == 2){
        printf("\nTry to load kernel module via init_module syscall\n");
        printf("PID: %d, Comm: %s \n", pid, comm);
        printf("\n");
    }
}


fentry:vmlinux:do_init_module{
    $module = (struct module *)args->mod;

    //extract the data
    $state = $module->state;
    $name = $module->name;
    $taint_flag = $module->taints;

    printf("Module name: %s \n", $name);

    // no switch case , hmm
    if($state == 0) {printf("State: Module state live\n");}
    if($state == 1) {printf("State: Module state comming\n");}
    if($state == 2) {printf("State: Module state going\n");}
    if($state == 3) {printf("State: Module state unformed\n");}

    printf("Module version: %s \n", str($module->version));
    printf("Srcversion: %s \n", str($module->srcversion));

    // extract taint flag
    if($taint_flag & 0x1){printf("Taint flag: TAINT_PROPRIETARY_MODULE \n");}
    if($taint_flag & 0x2){printf("Taint flag: TAINT_FORCED_MODULE \n");}
    if($taint_flag & 0x4){printf("Taint flag: TAINT_CPU_OUT_OF_SPEC \n");}
    if($taint_flag & 0x8){printf("Taint flag: TAINT_FORCED_RMMOD \n");}
    if($taint_flag & 0x10){printf("Taint flag: TAINT_MACHINE_CHECK \n");}
    if($taint_flag & 0x20){printf("Taint flag: TAINT_BAD_PAGE	 \n");}
    if($taint_flag & 0x40){printf("Taint flag: TAINT_USER	 \n");}
    if($taint_flag & 0x80){printf("Taint flag: TAINT_DIE \n");}
    if($taint_flag & 0x100){printf("Taint flag: TAINT_OVERRIDDEN_ACPI_TABLE \n");}
    if($taint_flag & 0x200){printf("Taint flag: TAINT_WARN	 \n");}
    if($taint_flag & 0x400){printf("Taint flag: TAINT_CRAP \n");}
    if($taint_flag & 0x800){printf("Taint flag: TAINT_FIRMWARE_WORKAROUND \n");}
    if($taint_flag & 0x1000){printf("Taint flag: TAINT_OOT_MODULE \n");}
    if($taint_flag & 0x2000){printf("Taint flag: TAINT_UNSIGNED_MODULE \n");}
    if($taint_flag & 0x4000){printf("Taint flag: TAINT_SOFTLOCKUP \n");}
    if($taint_flag & 0x8000){printf("Taint flag: TAINT_LIVEPATCH \n");}
    if($taint_flag & 0x10000){printf("Taint flag: TAINT_AUX \n");}
    if($taint_flag & 0x20000){printf("Taint flag: TAINT_RANDSTRUCT \n");}
    if($taint_flag & 0x40000){printf("Taint flag: TAINT_TEST \n");}
    if($taint_flag & 0x80000){printf("Taint flag: TAINT_FWCTL \n");}

}

END {
    printf("Close the pre execution detection script...\n");
}